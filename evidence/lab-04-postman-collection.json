      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/issues",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues"]
        }
      }
    },
    {
      "name": "Create issue",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Printer unavailable\",\n  \"description\": \"The shared printer is not responding.\",\n  \"priority\": \"Medium\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/issues",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues"]
        }
      }
    },
